# Ren 2 — copy to .env and fill in. Never commit .env.
# Missing values never stop Ren 2: the matching feature shows needs_credentials instead.

# Server
REN2_PORT=8700
REN2_HOST=127.0.0.1             # on the Pi: your Tailscale IP (install-pi.sh sets it)
REN2_OWNER_TOKEN=               # long random string; required to open the dashboard
REN2_DASHBOARD_URL=             # e.g. http://ren-pi.tailnet-name.ts.net:8700 (used in Telegram links)

# Budget
REN2_DAILY_BUDGET_USD=5

# Models (any subset; the router falls back through config/models.yaml)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# CLAUDE_BIN=claude             # headless Claude Code CLI (uses your own login)
# REN2_PROVIDERS_OFF=           # comma list to disable: anthropic,deepseek,kimi,ollama,claude_code

# Telegram (BotFather token + your numeric chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Project adapters: mock (fixtures, labelled MOCK) or live (needs real API routes)
REN2_ADAPTER_MODE=mock
BUILDER_URL=http://127.0.0.1:8400
BUILDER_TOKEN=
STOREFRONT_URL=http://127.0.0.1:8200
STOREFRONT_TOKEN=
SHOWRUNNER_URL=http://127.0.0.1:8300
SHOWRUNNER_TOKEN=
BGE_URL=http://127.0.0.1:8601
BGE_TOKEN=
MEME_URL=http://127.0.0.1:8500
TRADING_URL=http://127.0.0.1:8000
OLD_REN_URL=http://127.0.0.1:8100

# One-time knowledge import (read-only copy)
OLD_REN_KNOWLEDGE_PATH=

# Social publishing (only the platform Kevin picks)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# TTS (optional; not wired yet)
PIPER_BIN=
ELEVENLABS_API_KEY=
